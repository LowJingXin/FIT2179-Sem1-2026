{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": "Population by State in Malaysia",
  "data": {"url": "../data/population_state_clean.csv"},
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "y": {
        "field": "state",
        "type": "nominal",
        "sort": "-x",
        "title": "State"
    },
    "x": {
        "field": "population",
        "type": "quantitative",
        "title": "Population"
    },
    "tooltip": [
        {
            "field": "state",
            "type": "nominal",
            "title": "State"
        },
        {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
        },
        {
            "field": "population",
            "type": "quantitative",
            "title": "Population"
        }
    ]
  }
}