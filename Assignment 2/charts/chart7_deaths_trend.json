{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Number of Deaths in Malaysia Over Time",
  "width": 800,
  "height": 400,
  "data": {
    "url": "../data/death_clean.csv"
  },
  "mark": {
    "type": "line",
    "point": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": -45
      }
    },
    "y": {
      "field": "death",
      "type": "quantitative",
      "title": "Number of deaths"
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "death",
        "type": "quantitative",
        "title": "Number of deaths"
      }
    ]
  }
}