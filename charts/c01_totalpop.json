{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/total_population_malaysia_clean.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "color": "#1e40af",
          "strokeWidth": 2.5
        },
        "point": true,
        "color": {
          "gradient": "linear",
          "x1": 0,
          "y1": 0,
          "x2": 0,
          "y2": 1,
          "stops": [
            {
              "offset": 0,
              "color": "rgba(30,64,175,0.22)"
            },
            {
              "offset": 1,
              "color": "rgba(30,64,175,0)"
            }
          ]
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "labelAngle": 0,
            "title": "Year",
            "values": ["2000", "2005", "2010", "2015", "2020", "2025"]
          }
        },
        "y": {
          "field": "population",
          "type": "quantitative",
          "title": "Population ('000)",
          "scale": {
            "zero": false
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "population",
            "title": "Population ('000)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "params": [
        {
          "name": "hp",
          "select": {
            "type": "point",
            "on": "mouseover",
            "nearest": true,
            "fields": [
              "year"
            ]
          }
        }
      ],
      "mark": {
        "type": "line",
        "point": true,
        "filled": true,
        "size": 60,
        "color": "#1e40af"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "population",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": 1
          },
          "value": 0
        }
      }
    }
  ]
}