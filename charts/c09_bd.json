{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/birth_death_clean.csv"
  },
  "transform": [
    {
      "calculate": "upper(slice(datum.type, 0, 1)) + (slice(datum.type, 1))",
      "as": "type"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "labelAngle": 0,
            "title": "Year",
            "values": [
              "2000",
              "2005",
              "2010",
              "2015",
              "2020",
              "2025"
            ]
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Count"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Births",
              "Deaths"
            ],
            "range": [
              "#1e40af",
              "#9a3412"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 45
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Births",
              "Deaths"
            ],
            "range": [
              "#1e40af",
              "#9a3412"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "type",
            "title": "Type"
          },
          {
            "field": "value",
            "title": "Count",
            "format": ","
          }
        ]
      }
    }
  ]
}