{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 400,
  "title": "Malaysia's Total Population Over Time",
  "data": {
    "url": "data/total_population_malaysia_clean.csv"
  },
  "mark": {
    "type": "line",
    "point": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "population",
      "type": "quantitative",
      "title": "Population ('000)"
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "population",
        "type": "quantitative",
        "title": "Population"
      }
    ]
  }
}
