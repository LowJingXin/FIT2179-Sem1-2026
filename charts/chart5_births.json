{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Number of Births in Malaysia Over Time",
  "width": 800,
  "height": 400,
  "data": {
    "url": "data/birth_clean.csv"
  },
  "mark": {
    "type": "line",
    "point": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": -45
      }
    },
    "y": {
      "field": "births",
      "type": "quantitative",
      "title": "Number of births"
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "births",
        "type": "quantitative",
        "title": "Number of births"
      }
    ]
    }
}